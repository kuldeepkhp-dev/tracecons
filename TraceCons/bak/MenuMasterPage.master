<%@ master language="C#" autoeventwireup="true" inherits="MenuMasterPage, App_Web_ixcqzp9m" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <title>
    <% if (Session["RCMCNo"] != null)
           {
            
              Response.Write("Exporter Module");
           }
           else
           {
               Response.Write("Importer Module");
           }
    
    %>
    </title>
    <link href="SSheets/MasterStyle.css" rel="stylesheet" type="text/css" />  
    <script language="javascript" src="JS/encmd5.js"></script>
    <script language="javascript" src="JS/JScript.js"></script>
    <script language="javascript" src="JS/date-picker.js"></script>
    <script language="javascript" src="JS/suycCalendar.js"></script>
    <script language="javascript" src="JS/AgmarkJScript.js"></script>
    
    <meta http-equiv="Expires" content="0">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Cache-Control" content="no-cache">

   
</head>
<body topmargin="0" leftmargin="0" rightmargin="0"  onload="javascript:history.go(1);">
    <form id="form1" runat="server" autocomplete="off">
        <asp:ScriptManager ID="ScriptManager1" runat="server">
        </asp:ScriptManager>
    <table width="100%" border="0">
    <tr>
    <td background="images/bg.jpg" colspan="5">
        <asp:Image ID="Image1" ImageUrl="~/images/Header.jpg" runat="server" /></td>
    </tr>
    
    <tr class="row2">
        <td align="center"  colspan="1">
            <%--[<a href="javascript:void(0);" onClick="javascript:OpenWindow_Chg_Password('ChangePasswordP.aspx')">Change Password</a>]--%></td>
    <td  colspan="4" align="right">
        
       <a href="Logimpout.aspx"> <img src="images/logout.gif" border="0" /></a>
        </td>
    </tr>
      
    
    
    <tr> 
        <% 
            if (Session["ActiveFlag"].ToString() == "Y")
            {  
        %>
        <% 
            if (Session["Report1"].ToString() == "Y")
            {
                if (Session["RCMCNo"] != null)
                {  %>
             <td valign="top" class="row2" style="height: 32px" align="center">
        <a href="yourcont.aspx" ><b>Know Your containers</b> </a>
        </td>
            
            <%
               
            }
            else
            {
                %>
        <td valign="top" class="row2" style="height: 32px" align="center">
        <a href="traceCons.aspx" ><b>Know your container</b> </a>
        </td>
         <%
               
            }
        }%>
        <% 
            if (Session["Report2"].ToString() == "Y")
            {%>
         <td valign="top" class="row2" style="height: 32px" align="center">
         <a href="noofPSCIssued.aspx" ><b>Number of containers likely to be 
             <br />
             shipped from India in  next 2-3 days </b></a></TD>
             
             <%} %>
              <% 
            if (Session["Report3"].ToString() == "Y")
            {%>
          <td valign="top" class="row2" style="height: 32px" align="center">
         <a href="NoofAgmarkIssued.aspx" > <b>Number of containers likely to be<br />
             shipped from India in 
             
             next one week </b> </a></td>
              <%} %>
              <% 
            if (Session["Report4"].ToString() == "Y")
            {%>
          <td valign="top" class="row2" style="height: 32px" align="center">
         
         <a href="CountryWiseIssued.aspx" > <b>Country wise containers shipped
             <br />
             (Season-<% Response.Write(System.DateTime.Today.Year.ToString()); %>) </b></a>
          </td>
          <%} %>
       <% 
            }
            else
            {
        %>
     
        
        <%} %>
     </tr>
     
      <% 
            if (Session["ActiveFlag"].ToString() == "Y")
            {  
        %>
       <tr>
       <% 
            if (Session["Report1"].ToString() == "Y")
            {%>
            <td align="center" class="row2"  valign="top" >
                <b>A</b></td>
                <%} %>
            <% 
            if (Session["Report2"].ToString() == "Y")
            {%>
            <td align="center" class="row2"  valign="top">
                <b>B</b></td>
                <%} %>
                <% 
            if (Session["Report3"].ToString() == "Y")
            {%>
            <td align="center" class="row2"  valign="top">
                <b>C</b></td>
                <%} %>
                <% 
            if (Session["Report4"].ToString() == "Y")
            {%>
            <td align="center" class="row2"  valign="top">
                <b>D</b></td>
                <%} %>
        </tr>
        <%} %>
     <tr>   
    <td colspan="5" class="row2">
        <asp:contentplaceholder id="RegCPH" runat="server">
        
        
        </asp:contentplaceholder>
        </td>
    </tr>
   
  
    </table>
        

    </form>
</body>
</html>
